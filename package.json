    "@supabase/supabase-js": "2.115.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
