# Public values: copied into browser bundles at build time. Use a NEW dedicated project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Choose Responses API models with JSON schema support available in your account.
OPENAI_MODEL=
# Optional. Leave empty to disable fallback instead of silently changing models.
OPENAI_FALLBACK_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
AI_HOURLY_LIMIT=30
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
# Optional in-app support reporting (Resend).
RESEND_API_KEY=
SUPPORT_REPORT_TO=
SUPPORT_REPORT_FROM=
