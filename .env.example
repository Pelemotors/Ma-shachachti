NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna in Lean V1.
OPENAI_MODEL=
# Required for voice transcription. Do not invent a fallback.
OPENAI_TRANSCRIPTION_MODEL=

# Required for /api/cron/* and push delivery readiness.
CRON_SECRET=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Runtime public key (preferred on server; avoids empty NEXT_PUBLIC inlining).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# Resend is used by Supabase Auth SMTP (configured in supabase/.env on the VPS),
# not by the Next.js process. Keep the API key out of git.
# RESEND_API_KEY=
# Recommended verified sender for Auth SMTP_ADMIN_EMAIL:
# SMTP_ADMIN_EMAIL=noreply@mashachachti.co.il

# Mobile / Native (owner-provided; leave empty until configured)
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APNS_KEY_ID=
APNS_KEY_P8=
APNS_HOST=
GOOGLE_ANDROID_CLIENT_ID=
# Optional Web Sign-In client. If empty, GOOGLE_CALENDAR_CLIENT_ID is the Web fallback.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Optional. Production default is https://mashachachti.co.il/api/calendar/oauth/callback
GOOGLE_CALENDAR_REDIRECT_URI=
FCM_SERVER_KEY=
NATIVE_PUSH_ENABLED=false
SHARE_CAPTURE_ENABLED=true
MOBILE_VOICE_ENABLED=true
MONETIZATION_ENABLED=false
MOBILE_LATEST_VERSION=0.2.0-lean
MOBILE_MINIMUM_VERSION=0.2.0-lean
CAPACITOR_SERVER_URL=https://mashachachti.co.il
